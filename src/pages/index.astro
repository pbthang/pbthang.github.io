---
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Layout from "../layouts/Layout.astro";
import { profile, contacts } from "../data/profile";
import { education, experience, others } from "../data/timeline";
import { skills } from "../data/skills";
import { projects } from "../data/projects";
---

<Layout contacts={contacts} photo={profile.image}>
  <Hero />
  <main>
    <Experience experience={experience} education={education} others={others} />
    <Projects projects={projects} />
    <Skills skills={skills} />
    <Contact contacts={contacts} playlistUrl={profile.playlistUrl} />
  </main>
</Layout>
