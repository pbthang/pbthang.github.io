---
import type { Project } from "../data/projects";
import { padMetrics } from "../lib/pads";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props as Props;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section class="sec" id="projects" aria-labelledby="projects-h">
  <div class="sec-head">
    <h2 class="h-legend sec-title" id="projects-h">Projects</h2>
    <span class="refdes" aria-hidden="true">U3</span>
  </div>

  <ul class="modules">
    {
      projects.map((p, i) => (
        <li class="module component place" style={`--place-delay: ${(i % 3) * 70}ms`}>
          <span class="refdes" aria-hidden="true">{`U3.${i + 1}`}</span>
          <a class="module-marking" href={p.link} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
            <img src={p.imgSrc} alt="" loading="lazy" decoding="async" width="800" height="450" />
          </a>
          <div class="module-body">
            <h3 class="module-title">{p.title}</h3>
            <p class="module-desc" set:html={padMetrics(p.description)} />
            <a class="testpoint module-tp" href={p.link} target="_blank" rel="noreferrer">
              <span>{host(p.link)}</span>
              <span class="sr-only">: {p.title}</span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .module {
    grid-column: span 3;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    overflow: clip;
    transition: border-color 0.35s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .module:nth-child(1),
  .module:nth-child(2) {
    grid-column: span 6;
  }
  .module:hover {
    border-color: var(--line-strong);
  }
  .module::before {
    z-index: 2;
    box-shadow: 0 0 0 3px var(--board);
  }
  .module > .refdes {
    top: auto;
    bottom: 0.7rem;
    right: 0.9rem;
  }
  .module-marking {
    display: block;
    aspect-ratio: 16 / 9;
    background: #070a12;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .module-marking img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: saturate(0.85) contrast(1.02);
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease-out);
  }
  .module:hover .module-marking img {
    transform: scale(1.03);
    filter: saturate(1) contrast(1);
  }
  .module-body {
    padding: 1.25rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .module-title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .module-desc {
    margin: 0;
    color: var(--legend-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    flex: 1;
  }
  .module-tp {
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .module,
    .module:nth-child(1),
    .module:nth-child(2) {
      grid-column: span 6;
    }
  }
  @media (max-width: 600px) {
    .module,
    .module:nth-child(1),
    .module:nth-child(2) {
      grid-column: span 12;
    }
  }
</style>
