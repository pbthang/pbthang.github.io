---
import { profile } from "../data/profile";
import { sections } from "./TitleBlock.astro";

const roles = profile.typewriter.map((s) => s.replace(/[,.]$/, ""));
const heroLabel = `${profile.name}: ${roles.join(", ")}.`;

// The console script, in order. Shared by the DOM console and the laptop screen.
const script: { kind: "cmd" | "out"; text: string }[] = [
  { kind: "cmd", text: "whoami" },
  { kind: "out", text: profile.fullName },
  { kind: "cmd", text: "cat info.txt" },
  ...profile.bio.info.map((t) => ({ kind: "out" as const, text: t })),
  { kind: "cmd", text: "less interest.txt" },
  { kind: "out", text: profile.bio.interest },
];
---

<section class="hero" id="top" aria-label="Introduction">
  <div class="hero-grid">
    <div class="intro">
      <h1 class="name">{profile.name}</h1>
      <p class="role font-mono">
        <span class="sr-only">{heroLabel}</span>
        <span aria-hidden="true">
          a <span id="typewriter" data-strings={JSON.stringify(profile.typewriter)}></span>
        </span>
      </p>
      <p class="tagline measure">
        {profile.role} at {profile.company}, {profile.location}. Full-stack
        development and database systems: owning a feature from the UI down to
        the schema, and making queries fast when the data gets big.
      </p>
      <div class="intro-links">
        <a class="testpoint" href="#experience">Experience</a>
        <a class="testpoint" href={profile.resume} target="_blank" rel="noreferrer"
          >Resume</a
        >
      </div>
    </div>

    <div class="u1 footprint place" style="--place-delay: 80ms">
      <span class="refdes" aria-hidden="true">U1</span>
      <span class="u1-legend legend" aria-hidden="true">MCU · {profile.handle}</span>
      <canvas class="laptop" aria-hidden="true"></canvas>
      <span class="pins pins-b" aria-hidden="true"></span>
    </div>

    <figure class="console component place" style="--place-delay: 180ms">
      <span class="refdes" aria-hidden="true">U1 · CONSOLE</span>
      <div class="console-body" id="console" data-script={JSON.stringify(script)}>
        {
          script.map((l) => (
            <span class={`ln ln-${l.kind}`}>
              {l.kind === "cmd" ? "$ " : ""}
              {l.text}
            </span>
          ))
        }
        <span class="ln ln-cmd">$ <span class="caret">_</span></span>
      </div>
      <figcaption class="sr-only">Terminal-style introduction</figcaption>
    </figure>
  </div>

  <!-- Traces leaving U1's bottom pins toward each section's net. -->
  <svg class="traces" viewBox="0 0 1200 120" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
    {
      sections.map((s, i) => {
        // Pins under U1 on the right; each net runs left with 45-degree chamfers
        // at a different height so no two traces cross.
        const x0 = 790 + i * 60;
        const x1 = 200 + i * 230;
        const y = 22 + i * 18;
        const c = 12;
        return (
          <g class="trace">
            <path d={`M${x0} 0 V${y - c} L${x0 - c} ${y} H${x1 + c} L${x1} ${y + c} V96`} />
            <circle cx={x1} cy="102" r="6" />
            <text x={x1 + 14} y="106">{s.net}</text>
          </g>
        );
      })
    }
  </svg>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 4rem) 0;
    overflow: clip;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-areas:
      "intro laptop"
      "console laptop";
    gap: 2rem clamp(1.5rem, 4vw, 4rem);
    max-width: 78rem;
    margin: 0 auto;
    align-items: start;
  }
  .intro {
    grid-area: intro;
    padding-top: clamp(0.5rem, 3vw, 2.5rem);
  }
  .name {
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 1rem;
  }
  .role {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--gold-2);
    letter-spacing: 0.01em;
    margin: 0 0 1.5rem;
    min-height: 1.6em;
  }
  .tagline {
    color: var(--legend-2);
    font-size: 1.0625rem;
    margin: 0 0 2rem;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .u1 {
    grid-area: laptop;
    position: relative;
    aspect-ratio: 1 / 0.95;
    min-height: 22rem;
    border-radius: 4px;
  }
  .u1 .refdes {
    position: absolute;
    top: 0.5rem;
    left: 0.8rem;
  }
  .u1-legend {
    position: absolute;
    right: 0.8rem;
    bottom: 0.5rem;
    font-size: 0.625rem;
  }
  .u1-nodisplay::after {
    content: "U1 · NO DISPLAY";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--steel);
  }
  .laptop {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  /* Pin row along the footprint's bottom edge. */
  .pins {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -0.35rem;
    height: 0.7rem;
    background: repeating-linear-gradient(
      90deg,
      var(--copper) 0 0.35rem,
      transparent 0.35rem 1.1rem
    );
    opacity: 0.9;
  }

  .console {
    grid-area: console;
    margin: 0;
    padding: 2rem 1.25rem 1.25rem;
    border-radius: 4px;
  }
  .console-body {
    margin: 0;
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    color: var(--legend);
    min-height: 15.5em;
  }
  .ln-cmd {
    color: var(--gold-2);
  }
  .ln-out {
    color: var(--legend);
  }
  .console-body .ln {
    display: block;
    white-space: pre-wrap;
    min-height: 1.7em;
  }
  .console-body .ln.hidden {
    display: none;
  }
  .caret {
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .traces {
    display: block;
    width: 100%;
    max-width: 78rem;
    margin: 1.5rem auto 0;
    height: 7.5rem;
  }
  .trace path {
    fill: none;
    stroke: var(--copper);
    stroke-width: 2;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
  .trace circle {
    fill: var(--board);
    stroke: var(--copper);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .trace text {
    font-family: "Azeret Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    fill: var(--steel);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "laptop"
        "console";
    }
    .u1 {
      aspect-ratio: 4 / 3;
      min-height: 16rem;
    }
    .traces {
      height: 4.5rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import Typewriter from "typewriter-effect/dist/core";
  import type { Line } from "../lib/laptop";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* Role typewriter */
  const typewriterEl = document.querySelector("#typewriter") as HTMLElement;
  const strings: string[] = JSON.parse(typewriterEl.dataset.strings ?? "[]");
  if (reduced) {
    typewriterEl.textContent = strings[0] ?? "";
  } else {
    new Typewriter(typewriterEl, {
      strings,
      autoStart: true,
      loop: true,
      cursor: "_",
      delay: 55,
    });
  }

  /* Console: one script drives the DOM console and the laptop screen. */
  const consoleEl = document.getElementById("console") as HTMLPreElement;
  const script: Line[] = JSON.parse(consoleEl.dataset.script ?? "[]");
  const lineEls = Array.from(
    consoleEl.querySelectorAll<HTMLSpanElement>(".ln")
  ).slice(0, script.length);
  const promptEl = consoleEl.querySelector(".ln:last-child") as HTMLElement;

  // Progress state: how many lines are complete and how far into the current one.
  const state = { lineIdx: script.length, charIdx: 0, typingDone: reduced };

  const fullText = (l: Line) => (l.kind === "cmd" ? "$ " : "") + l.text;

  const renderDom = () => {
    lineEls.forEach((el, i) => {
      const l = script[i];
      if (i < state.lineIdx) {
        el.textContent = fullText(l);
        el.classList.remove("hidden");
      } else if (i === state.lineIdx) {
        el.textContent = fullText(l).slice(0, state.charIdx);
        el.classList.remove("hidden");
      } else {
        el.classList.add("hidden");
      }
    });
    promptEl.style.display = state.lineIdx >= script.length ? "" : "none";
  };

  /* Typing driver */
  if (!reduced) {
    state.lineIdx = 0;
    state.charIdx = 0;
    renderDom();
    const step = () => {
      if (state.lineIdx >= script.length) {
        state.typingDone = true;
        renderDom();
        return;
      }
      const l = script[state.lineIdx];
      const full = fullText(l);
      state.charIdx++;
      if (state.charIdx > full.length) {
        state.lineIdx++;
        state.charIdx = 0;
        renderDom();
        setTimeout(step, l.kind === "cmd" ? 320 : 140);
        return;
      }
      renderDom();
      setTimeout(step, l.kind === "cmd" ? 60 : 12);
    };
    setTimeout(step, 700);
  } else {
    renderDom();
  }

  /* Laptop scene: three.js is split into its own chunk and loaded after the
     first paint, so the initial bundle stays small. */
  const canvas = document.querySelector(".laptop") as HTMLCanvasElement;
  const host = canvas.parentElement as HTMLElement;

  const fallback = (err: unknown) => {
    // No WebGL: the footprint stays printed and the console carries the bio.
    canvas.remove();
    host.classList.add("u1-nodisplay");
    console.warn("Laptop scene unavailable:", err);
  };

  const probe = document.createElement("canvas");
  const hasWebGL = !!(probe.getContext("webgl2") || probe.getContext("webgl"));
  if (!hasWebGL) {
    fallback("WebGL not supported");
  } else {
    const start = () =>
      import("../lib/laptop")
        .then(({ bootLaptop }) => bootLaptop({ canvas, host, reduced, script, state }))
        .catch(fallback);
    if ("requestIdleCallback" in window) {
      (window as any).requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>
